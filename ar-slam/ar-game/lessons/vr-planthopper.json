  "captions": [
    { "t": 0.6, "dur": 4.2, "text": "这片稻子，根上藏着小虫。", "voice": "这片稻子，根上藏着小虫。", "audio": null },
    { "t": 4.6, "dur": 4.4, "text": "拿放大镜看——这是稻飞虱，米粒那么大。", "voice": "拿放大镜看，这是稻飞虱，只有米粒那么大。", "audio": null },
    { "t": 9.2, "dur": 3.4, "text": "它把嘴扎进稻秆，吸稻子的汁。", "voice": "它把嘴像针一样扎进稻秆，吸稻子的汁。", "audio": null },
    { "t": 13.0, "dur": 4.2, "text": "虫越生越多，二十天就是一大群。", "voice": "虫越生越多，二十天就是一大群。", "audio": null },
    { "t": 17.6, "dur": 4.2, "text": "稻秆被吸干，一团一团发黄倒下。", "voice": "稻秆被吸干，从根部开始发黄，一团一团倒下。", "audio": null },
    { "t": 22.0, "dur": 3.0, "text": "这叫冒穿。不早防，就要减产。", "voice": "这就叫冒穿。不早点防，就要减产。", "audio": null },
    { "t": 25.6, "dur": 3.4, "text": "个头像一粒米，身上黄褐色。", "voice": "怎么认出它？个头像一粒米，身上黄褐色。", "audio": null },
    { "t": 29.2, "dur": 3.0, "text": "翅膀合起来像个屋顶。", "voice": "翅膀合起来像个屋顶，比肚子还长。", "audio": null },
    { "t": 32.6, "dur": 3.0, "text": "后腿上有根刺，认准它。", "voice": "后腿上长着一根刺，认准这个记号。", "audio": null },
    { "t": 37.6, "dur": 3.2, "text": "关键在早：虫刚来，就发现它。", "voice": "怎么防？关键在早，虫刚来的时候就发现它。", "audio": null },
    { "t": 42.0, "dur": 4.0, "text": "拿白盘放在稻根下，拍一拍。", "voice": "拿白盘子放在稻根下面，拍一拍。", "audio": null },
    { "t": 46.0, "dur": 2.4, "text": "盘里虫多了，就该打药了。", "voice": "盘子里虫多了，就该打药了。", "audio": null },
    { "t": 49.5, "dur": 3.5, "text": "药要喷到稻根上，虫就躲在那儿。", "voice": "药要喷到稻秆根上，虫就躲在那儿。", "audio": null },
    { "t": 54.2, "dur": 3.6, "text": "早查早治，稻子就保住了。", "voice": "早查早治，稻子就保住了。", "audio": null }
  ]
